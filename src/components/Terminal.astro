---
/**
 * A terminal: lines of `{ prompt?, text, dim? }`; a cursor blinks on the
 * last line. Static markup — the product working is the demo, not an
 * animation of it.
 */
interface Props { title?: string; lines: { prompt?: string; text: string; dim?: boolean }[]; class?: string }
const { title = "terminal", lines, class: cls = "" } = Astro.props;
---
<div class:list={["overflow-hidden rounded-xl border bg-card shadow-window", cls]}>
  <div class="flex h-9 items-center gap-2 border-b border-border-soft bg-muted/60 px-3">
    <span class="flex gap-1.5" aria-hidden="true"><i class="size-2.5 rounded-full bg-border"></i><i class="size-2.5 rounded-full bg-border"></i><i class="size-2.5 rounded-full bg-border"></i></span>
    <span class="ml-2 font-mono text-xs text-muted-foreground">{title}</span>
  </div>
  <pre class="overflow-x-auto p-5 font-mono text-[0.85rem] leading-relaxed text-foreground"><code>{lines.map((l, i) => (
    <span class:list={["block", l.dim && "text-muted-foreground"]}>{l.prompt && <span class="text-primary">{l.prompt} </span>}{l.text}{i === lines.length - 1 && <span class="ml-0.5 inline-block h-[1.1em] w-[0.55em] translate-y-[0.2em] animate-pulse bg-primary/80" aria-hidden="true"></span>}</span>
  ))}</code></pre>
</div>
