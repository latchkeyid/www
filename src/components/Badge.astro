---
interface Props { tone?: "neutral" | "accent" | "success" | "warning" | "info"; class?: string }
const { tone = "neutral", class: cls = "" } = Astro.props;
const tones = {
  neutral: "border-border bg-muted text-muted-foreground",
  accent: "border-primary/30 bg-accent-soft text-primary",
  success: "border-success/40 bg-success/10 text-success",
  warning: "border-warning/40 bg-warning/10 text-warning",
  info: "border-info/40 bg-info/10 text-info",
};
---
<span class:list={["inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-[0.7rem] tracking-wide uppercase", tones[tone], cls]}><slot /></span>
