---
/**
 * Columns of links, then "the house": every sibling product with its own
 * accent dot, so each site points at the others. Pass `product` to leave
 * the current one out.
 */
import { house } from "../house";
interface Props {
  name: string;
  product?: string;
  columns?: { title: string; links: { label: string; href: string }[] }[];
  legal?: string;
}
const { name, product, columns = [], legal = `© ${new Date().getFullYear()} ${name}` } = Astro.props;
const ring = house.filter((p) => p.id !== product);
const blurb = (await Astro.slots.render("blurb")).trim();
---
<footer class="mt-24 border-t">
  <div class="mx-auto w-full max-w-page px-6 py-14 md:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="max-w-xs">
        <p class="font-display text-2xl">{name}</p>
        {blurb && <p class="mt-3 text-sm text-muted-foreground" set:html={blurb} />}
      </div>
      {columns.map((c) => (
        <div>
          <p class="eyebrow mb-3 text-muted-foreground">{c.title}</p>
          <ul class="grid gap-2">
            {c.links.map((l) => <li><a href={l.href} class="text-sm text-muted-foreground hover:text-foreground">{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    {ring.length > 0 && (
      <div class="mt-14 border-t border-border-soft pt-8">
        <p class="eyebrow mb-4 text-muted-foreground">The house</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {ring.map((p) => (
            <li>
              <a href={p.url} class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground" title={p.line}>
                <span class="inline-block size-1.5 rounded-full" style={`background: var(--house-${p.accent}, var(--muted-foreground))`} aria-hidden="true"></span>{p.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <p class="mt-10 text-xs text-muted-foreground">{legal}</p>
  </div>
</footer>
