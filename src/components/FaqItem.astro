---
/** <details> so it works without JS and the answer is in the HTML for search. */
interface Props { q: string; open?: boolean }
const { q, open = false } = Astro.props;
---
<details class="group px-6" open={open}>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-base font-medium [&::-webkit-details-marker]:hidden">
    {q}
    <svg class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  </summary>
  <div class="pb-6 text-sm text-muted-foreground"><slot /></div>
</details>
