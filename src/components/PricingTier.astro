---
/** One tier. `featured` gets the accent border and the primary button. */
import Button from "./Button.astro";
interface Props {
  name: string;
  price: string;
  period?: string;
  blurb?: string;
  features?: string[];
  cta?: { label: string; href: string };
  featured?: boolean;
}
const { name, price, period, blurb, features = [], cta, featured = false } = Astro.props;
---
<div class:list={["reveal flex flex-col rounded-xl border bg-card p-6 shadow-card", featured && "border-primary/50 ring-1 ring-primary/30"]}>
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-medium tracking-tight">{name}</h3>
    {featured && <span class="eyebrow">Most teams</span>}
  </div>
  <p class="mt-4 flex items-baseline gap-1">
    <span class="font-display text-5xl leading-none">{price}</span>
    {period && <span class="text-sm text-muted-foreground">{period}</span>}
  </p>
  {blurb && <p class="mt-3 text-sm text-muted-foreground">{blurb}</p>}
  <ul class="mt-6 grid gap-2.5 text-sm">
    {features.map((f) => (
      <li class="flex gap-2.5">
        <svg class="mt-1 size-3.5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
        <span class="text-muted-foreground">{f}</span>
      </li>
    ))}
  </ul>
  {cta && <div class="mt-8"><Button href={cta.href} variant={featured ? "primary" : "outline"} class="w-full">{cta.label}</Button></div>}
</div>
