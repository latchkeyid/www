---
/** A page section: vertical rhythm, optional eyebrow + heading + lede on the left. */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  class?: string;
  /** "tight" halves the padding for stacked sections. */
  spacing?: "normal" | "tight";
}
const { id, eyebrow, title, lede, class: cls = "", spacing = "normal" } = Astro.props;
// Same markup as Hero: *word* is the italic accent word.
const parts = (title ?? "").split(/\*([^*]+)\*/);
---
<section id={id} class:list={[spacing === "tight" ? "py-12 md:py-16" : "py-20 md:py-28", cls]}>
  <div class="mx-auto w-full max-w-page px-6 md:px-8">
    {(eyebrow || title || lede) && (
      <header class="reveal mb-10 max-w-2xl md:mb-14">
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        {title && <h2 class="display-2">{parts.map((p, i) => (i % 2 === 1 ? <em class="display-accent">{p}</em> : p))}</h2>}
        {lede && <p class="mt-4 text-lg text-muted-foreground">{lede}</p>}
      </header>
    )}
    <slot />
  </div>
</section>
