---
/**
 * Documentation: the Site frame with a left nav (groups of pages the
 * site builds from its content collection) and a prose column. The nav
 * is sticky from lg; on small screens it is a <details> above the text.
 */
import Site from "./Site.astro";
interface Props {
  title: string;
  description: string;
  product: string;
  nav: { group: string; items: { title: string; href: string }[] }[];
  links?: { label: string; href: string }[];
  cta?: { label: string; href: string } | null;
  /** Shown above the h1 in the eyebrow style. */
  section?: string;
  edit?: string;
}
const { title, description, product, nav, links, cta, section = "Docs", edit } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const current = (href: string) => path === href.replace(/\/$/, "");
---
<Site title={title} description={description} product={product} links={links} cta={cta}>
  <div class="mx-auto grid w-full max-w-page gap-10 px-6 py-10 md:px-8 lg:grid-cols-[14rem_1fr] lg:py-14">
    <details class="lg:hidden">
      <summary class="cursor-pointer list-none rounded-md border bg-card px-4 py-2.5 text-sm [&::-webkit-details-marker]:hidden">{section} navigation</summary>
      <nav class="mt-3 grid gap-5" aria-label="Docs">
        {nav.map((g) => (
          <div>
            <p class="eyebrow mb-2 text-muted-foreground">{g.group}</p>
            <ul class="grid gap-1">{g.items.map((i) => <li><a href={i.href} class:list={["block rounded-md px-2 py-1 text-sm", current(i.href) ? "bg-accent-soft text-primary" : "text-muted-foreground hover:text-foreground"]}>{i.title}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </details>
    <nav class="sticky top-24 hidden self-start lg:grid lg:gap-6" aria-label="Docs">
      {nav.map((g) => (
        <div>
          <p class="eyebrow mb-2 text-muted-foreground">{g.group}</p>
          <ul class="grid gap-0.5 border-l border-border-soft">
            {g.items.map((i) => (
              <li><a href={i.href} class:list={["-ml-px block border-l py-1 pl-3 text-sm transition-colors", current(i.href) ? "border-primary text-foreground" : "border-transparent text-muted-foreground hover:border-border hover:text-foreground"]} aria-current={current(i.href) ? "page" : undefined}>{i.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <article class="min-w-0">
      <p class="eyebrow mb-3">{section}</p>
      <div class="prose"><slot /></div>
      {edit && <p class="mt-12 text-sm"><a href={edit} class="text-muted-foreground hover:text-foreground">Edit this page →</a></p>}
    </article>
  </div>
</Site>
