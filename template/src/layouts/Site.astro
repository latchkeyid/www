---
/**
 * The product's page frame: the site's stylesheet (Tailwind + the shell's
 * base + this product's accent) and its facts from site.ts, over the
 * shell's Site layout. Pages set title/description; everything else is
 * defined once here.
 */
import "../styles/global.css";
import Base from "@latchkey/www/layouts/Site.astro";
import { site } from "../site";
interface Props { title: string; description: string; ogImage?: string; footer?: boolean }
---
<Base {...site} {...Astro.props}>
  <slot name="logo" slot="logo" />
  <slot name="blurb" slot="blurb" />
  <slot />
</Base>
